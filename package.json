{
  "name": "ForgeAI",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.5",
    "turbo": "^2.10.7"
  },
  "lint-staged": {
    "apps/frontend/**/*.{js,ts,vue,json,css,md}": [
      "prettier --write --experimental-cli"
    ],
    "apps/backend/**/*.py": [
      "uv run --directory apps/backend ruff check --fix",
      "uv run --directory apps/backend ruff format"
    ]
  }
}
