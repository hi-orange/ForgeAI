{
  "spec": {
    "goal": "做一个招聘网站：让求职者能浏览、搜索职位并投递申请，让招聘方（企业）能发布职位并查看收到的申请，从而在同一站点内完成「找工作」与「招人」的闭环。",
    "target_users": [
      "求职者：浏览职位、投递申请、跟踪自己的申请状态",
      "招聘方/企业用户：发布与管理职位、查看并处理收到的申请",
      "（默认）站点访客：未登录时也能浏览和搜索职位"
    ],
    "features": [
      {
        "id": "feat_job_browse",
        "text": "职位浏览与搜索：访客无需登录即可按关键词、城市、职位类型筛选职位列表，列表显示职位名称、公司、地点、薪资范围与发布时间，并支持分页。"
      },
      {
        "id": "feat_job_detail",
        "text": "职位详情页：展示职位描述、任职要求、薪资、工作地点、公司简介与发布方信息，并提供「投递」入口。"
      },
      {
        "id": "feat_auth",
        "text": "账号注册与登录：求职者与招聘方分别注册登录，登录状态在刷新后保持，未登录用户执行投递或发布时被引导登录。"
      },
      {
        "id": "feat_resume_profile",
        "text": "求职者简历资料：填写并保存姓名、联系方式、期望职位、期望城市、工作经历与技能，可随时编辑，刷新后仍可读取。"
      },
      {
        "id": "feat_apply",
        "text": "投递职位：在职位详情页提交申请（可附一段求职留言），提交后写入后端并防止对同一职位重复投递。"
      },
      {
        "id": "feat_my_applications",
        "text": "我的投递记录：求职者查看自己投递过的职位列表及每条申请的状态（已投递/已查看/已拒绝/已录用），刷新后仍可读取。"
      },
      {
        "id": "feat_company_job_manage",
        "text": "招聘方职位管理：招聘方创建、编辑、上下架自己发布的职位，只能管理本企业发布的职位。"
      },
      {
        "id": "feat_application_inbox",
        "text": "申请收件箱：招聘方按职位查看收到的申请，看到申请人简历摘要与留言，并更新申请状态。"
      },
      {
        "id": "feat_seed_data",
        "text": "初始可浏览内容：站点预置一批可复现的开发种子数据（示例公司、职位、招聘方账号），使首次打开就有真实可搜索的职位列表，而非前端写死的假数据。"
      }
    ],
    "data_requirements": [],
    "interface_requirements": [],
    "constraints": [],
    "acceptance_criteria": [
      {
        "id": "ac_browse",
        "text": "当访客在职位列表输入关键词或选择城市筛选时，应调用后端接口返回匹配职位并更新列表与分页结果。",
        "source_ids": [
          "feat_job_browse"
        ]
      },
      {
        "id": "ac_detail",
        "text": "当访客从列表点击任一职位时，应打开该职位详情页并显示其描述、要求、薪资与公司信息。",
        "source_ids": [
          "feat_job_detail"
        ]
      },
      {
        "id": "ac_auth",
        "text": "当用户注册或登录成功后刷新页面，应仍保持登录状态；未登录用户点击投递时应被引导至登录。",
        "source_ids": [
          "feat_auth"
        ]
      },
      {
        "id": "ac_resume",
        "text": "当求职者保存简历资料后刷新页面，应能重新读取到已保存的姓名、联系方式与期望职位。",
        "source_ids": [
          "feat_resume_profile"
        ]
      },
      {
        "id": "ac_apply",
        "text": "当求职者提交投递后，应收到成功反馈，该申请出现在「我的投递」中，且对同一职位再次投递被拒绝并给出提示。",
        "source_ids": [
          "feat_apply"
        ]
      },
      {
        "id": "ac_my_applications",
        "text": "当求职者打开「我的投递」时，应列出其全部申请及当前状态，刷新后列表与状态保持一致。",
        "source_ids": [
          "feat_my_applications"
        ]
      },
      {
        "id": "ac_company_manage",
        "text": "当招聘方创建或下架职位后，该职位应出现在求职者端列表或从列表消失；招聘方无法编辑其他企业的职位。",
        "source_ids": [
          "feat_company_job_manage"
        ]
      },
      {
        "id": "ac_inbox",
        "text": "当招聘方在申请收件箱把某条申请状态改为「已查看」或「已拒绝」后，求职者端「我的投递」应显示更新后的状态。",
        "source_ids": [
          "feat_application_inbox"
        ]
      },
      {
        "id": "ac_seed",
        "text": "当首次打开站点时，职位列表应展示来自后端种子数据的示例职位，且这些职位可被搜索与投递。",
        "source_ids": [
          "feat_seed_data"
        ]
      }
    ],
    "open_questions": []
  },
