# App
APP_ENV=development
APP_NAME=ForgeAI
DEBUG=true
LOG_LEVEL=INFO
LOG_FILE=logs/forgeai.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agent_platform

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# DeepSeek
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Optional Product Manager market/competitor research
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Build once using sandbox/Dockerfile; generated code never executes on the host.
ENGINEERING_CHECK_IMAGE=forgeai-checks:fullstack-v1
ENGINEERING_CHECK_TIMEOUT_SECONDS=300

# Local loopback preview of completed apps (127.0.0.1 only; not a public gateway).
PREVIEW_ENABLED=true
PREVIEW_BIND_HOST=127.0.0.1
PREVIEW_PORT_MIN=18200
PREVIEW_PORT_MAX=18399
PREVIEW_IDLE_TIMEOUT_SECONDS=1800
PREVIEW_BUILD_TIMEOUT_SECONDS=180
PREVIEW_READY_TIMEOUT_SECONDS=90
