{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeai.local/schemas/fullstack-v1-manifest.json",
  "title": "FullstackV1Manifest",
  "type": "object",
  "required": ["template_version", "files"],
  "additionalProperties": false,
  "properties": {
    "template_version": {
      "type": "string",
      "const": "fullstack-v1"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._\\-/]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
