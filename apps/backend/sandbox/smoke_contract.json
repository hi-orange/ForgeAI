{
  "version": 1,
  "limits": {
    "manifest_bytes": 262144,
    "api_checks": 50,
    "browser_checks": 50,
    "actions_per_check": 80,
    "total_browser_actions": 400,
    "browser_timeout_seconds": 120,
    "browser_timeout_per_additional_check_seconds": 15,
    "browser_timeout_per_action_seconds": 2,
    "browser_timeout_max_seconds": 900,
    "browser_setup_timeout_seconds": 180,
    "all_timeout_max_seconds": 1200
  },
  "top_level_fields": ["version", "visual_contract", "api_checks", "browser_checks"],
  "visual_contract": {
    "applies_to_template": "fullstack-react-v1",
    "theme_file": { "type": "source_path", "prefix": "frontend/" },
    "theme_mode": { "enum": ["template", "custom", "preserve"] },
    "theme_reason": { "type": "string", "min_trimmed_length": 8 },
    "required_tokens": {
      "type": "string_array",
      "item_prefix": "--",
      "must_include": ["--color-primary", "--color-accent", "--color-muted"]
    },
    "local_assets": { "type": "source_path_array", "max_items": 30, "optional": true }
  },
  "api": {
    "fields": ["id", "method", "path", "json", "expect_status", "expect_json_paths", "capture", "headers"],
    "defaults": { "method": "GET", "expect_status": 200 },
    "capture": "Map a variable name to a JSON response path. Checks run in list order, and captured variables are available to later checks.",
    "variables": "Use ${name} in later API path, json body, or headers; the same captured variables are available to browser checks. A variable must first be captured by an earlier API check.",
    "authenticated_example": [
      {
        "id": "login",
        "method": "POST",
        "path": "/api/v1/auth/login",
        "json": { "username": "seeker", "password": "example-password" },
        "expect_status": 200,
        "capture": { "seeker_token": "data.access_token" }
      },
      {
        "id": "read-profile",
        "path": "/api/v1/profile",
        "headers": { "Authorization": "Bearer ${seeker_token}" },
        "expect_status": 200
      }
    ]
  },
  "browser": {
    "kinds": ["integration", "ui"],
    "default_kind": "integration",
    "expect_api": "Integration cases require expect_api. Strings require a successful path-prefix response; objects match exact method, path (including query), and status. UI cases may omit expect_api but require a visible assertion.",
    "response_fields": {
      "method": { "type": "string", "pattern": "^(GET|POST|PUT|PATCH|DELETE)$" },
      "path": { "type": "local_path" },
      "status": { "type": "integer", "minimum": 100, "maximum": 599 }
    },
    "default_viewport": {
      "width": 1440,
      "height": 900
    },
    "viewport": {
      "width": {
        "type": "integer",
        "minimum": 240,
        "maximum": 2560
      },
      "height": {
        "type": "integer",
        "minimum": 320,
        "maximum": 2160
      }
    },
    "actions": {
      "click": {
        "fields": {
          "selector": {
            "type": "string",
            "min_length": 1
          }
        }
      },
      "fill": {
        "fields": {
          "selector": {
            "type": "string",
            "min_length": 1
          },
          "value": {
            "type": "string"
          }
        }
      },
      "select": {
        "fields": {
          "selector": {
            "type": "string",
            "min_length": 1
          },
          "value": {
            "type": "string"
          }
        }
      },
      "navigate": {
        "fields": {
          "url": {
            "type": "local_path"
          }
        }
      },
      "wait_for_selector": {
        "fields": {
          "selector": {
            "type": "string",
            "min_length": 1
          }
        }
      },
      "expect_text": {
        "fields": {
          "text": {
            "type": "string",
            "min_length": 1
          }
        }
      },
      "expect_any_text": {
        "fields": {
          "texts": {
            "type": "string_array",
            "min_items": 2,
            "max_items": 10,
            "item_min_length": 1
          }
        }
      },
      "expect_path": {
        "fields": {
          "path": {
            "type": "local_path"
          }
        }
      },
      "expect_count": {
        "fields": {
          "selector": {
            "type": "string",
            "min_length": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        }
      },
      "expect_no_horizontal_scroll": {
        "fields": {}
      },
      "screenshot": {
        "fields": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          }
        }
      }
    }
  }
}
